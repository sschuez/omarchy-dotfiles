#!/usr/bin/env python3
"""Writes dead-keys (next to this script): US International dead keys that
behave like Windows/macOS. Edit the rules below and re-run, instead of editing
the generated file by hand. Apply with: omarchy restart xcompose

Rule: a dead key (' " ` ~ ^) combines with vowels only; ' then c gives ç and
~ then n gives ñ. Any other key, including a second dead key, types both
characters as-is (I'm, "hello", "$HOME", '').
"""
from pathlib import Path

DEAD_KEYS = [  # keysym, character it types, name for the comment
    ("dead_acute", "'", "Apostrophe"),
    ("dead_diaeresis", '"', "Double quote"),
    ("dead_grave", "`", "Backtick"),
    ("dead_tilde", "~", "Tilde"),
    ("dead_circumflex", "^", "Caret"),
]
KEEP_ACCENTS = set("aeiouAEIOU")  # combine as usual: ä é à ã ê ...
KEEP = {("dead_tilde", "n"), ("dead_tilde", "N")}  # ñ Ñ
SPECIAL = {("dead_acute", "c"): "ç", ("dead_acute", "C"): "Ç"}
PUNCTUATION = {
    "!": "exclam", '"': "quotedbl", "#": "numbersign", "$": "dollar", "%": "percent",
    "&": "ampersand", "'": "apostrophe", "(": "parenleft", ")": "parenright",
    "*": "asterisk", "+": "plus", ",": "comma", "-": "minus", ".": "period",
    "/": "slash", ":": "colon", ";": "semicolon", "<": "less", "=": "equal",
    ">": "greater", "?": "question", "@": "at", "[": "bracketleft",
    "\\": "backslash", "]": "bracketright", "_": "underscore", "{": "braceleft",
    "|": "bar", "}": "braceright",
}
KEYS = [(c, c) for c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"]
KEYS += [(name, char) for char, name in PUNCTUATION.items()]


def escape(text):
    return text.replace("\\", "\\\\").replace('"', '\\"')


lines = [
    "# US International dead keys, Windows/Mac-style.",
    "# A dead key (' \" ` ~ ^) only combines with vowels: \"a = ä, 'e = é, `a = à, ~a = ã, ^e = ê.",
    "# Exceptions: 'c = ç, ~n = ñ.",
    "# Anything else types both characters as-is: I'm, I'd, \"hello\", \"$HOME\", '', `npm`.",
    "# (Stock Linux turns 'm into ḿ, or leaves a stray ´ when no accented letter exists.)",
    "# Loaded from ~/.XCompose after Omarchy's rules, so these win.",
    "# Generated by generate-dead-keys: edit its rules there, not this file.",
    "# Apply with: omarchy restart xcompose",
    "",
]
for dead, char, name in DEAD_KEYS:
    lines.append(f"# {name} ({char})")
    for keysym, typed in KEYS:
        if typed in KEEP_ACCENTS or (dead, typed) in KEEP:
            continue
        lines.append(f'<{dead}> <{keysym}> : "{escape(SPECIAL.get((dead, typed), char + typed))}"')
    for dead2, char2, _ in DEAD_KEYS:
        lines.append(f'<{dead}> <{dead2}> : "{escape(char + char2)}"')
    lines.append("")

Path(__file__).with_name("dead-keys").write_text("\n".join(lines))
