#!/bin/sh
# Ctrl+h/j/k/l in Herdr, the way vim-tmux-navigator does it in tmux.
# Herdr binds the keys to this plugin's actions (../config.toml): with
# Neovim in the focused pane it hands the key on, so Neovim moves between its
# splits; otherwise it focuses the neighbouring Herdr pane. At its last split,
# Neovim calls this script again with "edge" to move on
# (nvim/.config/nvim/lua/plugins/tmux-navigator.lua).
#
# Usage: navigate left|down|up|right [edge]
#        (Herdr and Neovim both pass the pane in HERDR_PANE_ID)

herdr=${HERDR_BIN_PATH:-herdr}
# After `herdr update` swaps the binary under a running server, the path the
# server hands out can point at the deleted file; fall back to the one on PATH.
# (Borrowed from paulbkim-dev/vim-herdr-navigation, the same idea as a
# community plugin.)
[ -x "$herdr" ] || herdr=herdr
pane=$HERDR_PANE_ID

case $1 in
left) key=ctrl+h ;;
down) key=ctrl+j ;;
up) key=ctrl+k ;;
right) key=ctrl+l ;;
*)
	echo "usage: navigate left|down|up|right [edge]" >&2
	exit 2
	;;
esac

# Same programs as is_vim in tmux/.config/tmux/overrides.conf: the vim family
# and fzf. Skipped for "edge": that is Neovim itself asking, and the key would
# bounce straight back to it.
if [ "$2" != edge ] &&
	"$herdr" pane process-info --pane "$pane" | grep -qE '"name":"g?(view|l?n?vim?x?|fzf)(diff)?"'; then
	exec "$herdr" pane send-keys "$pane" "$key"
fi

# Move, and leave zoom on the way, as tmux's select-pane does. Herdr's own
# focus keeps the tab zoomed, on the pane it moved to. The reply to focus
# carries the zoom state, so un-zooming costs a second call only when zoomed.
# Un-zoom the pane now in focus: un-zooming the one we left would focus it again.
reply=$("$herdr" pane focus --pane "$pane" --direction "$1")
case $reply in
*'"zoomed":true'*)
	now=$(printf '%s' "$reply" | sed -n 's/.*"focused_pane_id":"\([^"]*\)".*/\1/p')
	exec "$herdr" pane zoom --off --pane "${now:-$pane}"
	;;
esac
