#!/usr/bin/env bash
# infomaniak: one command against Infomaniak's Public Cloud, project
# chalet-production, with its keys from 1Password for that command alone.
#
#   infomaniak openstack server list
#   infomaniak aws s3api get-bucket-cors --bucket chalet-production
#
# openstack signs in with an application credential of the project, aws with
# an S3 key pair of it (chalet's docs/deploy.md, steps 1 and 2). Each is an
# API Credential item in 1Password, the ID or access key as its username and
# the secret as its credential: "Infomaniak chalet-production OpenStack" and
# "Infomaniak chalet-production S3", in the vault Main of my personal account.
# INFOMANIAK_OP_ACCOUNT, INFOMANIAK_OP_VAULT, INFOMANIAK_OP_OPENSTACK_ITEM and
# INFOMANIAK_OP_S3_ITEM choose others.
#
# op run puts the keys in the command's environment and nowhere else: nothing
# in ~/.config/openstack/clouds.yaml or ~/.aws. Only the item the command
# needs is read, so either works without the other; any other command (a
# shell, a script) gets both. Needs the 1Password app signed in, with
# Settings > Developer > "Integrate with 1Password CLI" turned on.

set -euo pipefail

case ${1:-} in
  "" | -h | --help | help)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac

account=${INFOMANIAK_OP_ACCOUNT:-my.1password.eu}
vault=${INFOMANIAK_OP_VAULT:-Main}
openstack_item=${INFOMANIAK_OP_OPENSTACK_ITEM:-Infomaniak chalet-production OpenStack}
s3_item=${INFOMANIAK_OP_S3_ITEM:-Infomaniak chalet-production S3}

openstack_keys() {
  unset OS_CLOUD # an entry in a clouds.yaml would win over the variables below
  export OS_AUTH_TYPE=v3applicationcredential
  export OS_AUTH_URL=https://api.pub1.infomaniak.cloud/identity/v3
  export OS_IDENTITY_API_VERSION=3
  export OS_REGION_NAME=dc3-a
  export OS_INTERFACE=public
  export OS_APPLICATION_CREDENTIAL_ID="op://$vault/$openstack_item/username"
  export OS_APPLICATION_CREDENTIAL_SECRET="op://$vault/$openstack_item/credential"
}

# The endpoint, the region and the bucket in the path come from a file of
# their own (aws has no variable for the last); the keys from 1Password.
s3_keys() {
  export AWS_CONFIG_FILE="$HOME/.config/clouds/infomaniak-aws.conf"
  export AWS_ACCESS_KEY_ID="op://$vault/$s3_item/username"
  export AWS_SECRET_ACCESS_KEY="op://$vault/$s3_item/credential"
}

case $(basename "$1") in
  openstack) openstack_keys ;;
  aws) s3_keys ;;
  *) openstack_keys; s3_keys ;;
esac

exec op run --account "$account" -- "$@"
