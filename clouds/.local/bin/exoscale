#!/usr/bin/env bash
# exoscale: one command against Exoscale (submissio), with its API key from
# 1Password for that command alone.
#
#   exoscale exo compute instance list
#   exoscale exo storage ls sos://<bucket>
#
# The key is an API Credential item in submissio's 1Password, the key as its
# username and the secret as its credential. It is named below by its IDs:
# the account's, the vault's and the item's names are the company's, not this
# public repo's. EXOSCALE_OP_ACCOUNT, EXOSCALE_OP_VAULT and EXOSCALE_OP_ITEM
# choose another, by name or ID, say a narrower key.
#
# op run puts it in the command's environment and nowhere else: nothing in
# ~/.config/exoscale. Needs the 1Password app signed in, with Settings >
# Developer > "Integrate with 1Password CLI" turned on.

set -euo pipefail

case ${1:-} in
  "" | -h | --help | help)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac

account=${EXOSCALE_OP_ACCOUNT:-LYQ2QZB6QBCS3DQDPVKNWJ2OKI}   # submissio's 1Password
vault=${EXOSCALE_OP_VAULT:-c54ee3lt7vr4j3uwx3gdtubmze}
item=${EXOSCALE_OP_ITEM:-455prgnskp6zw2rkgf3viluweu}       # its Exoscale API key

# What the shell already holds for exo (another account of its config file,
# another key) would win over the key below, or mix into it.
for name in $(compgen -e); do
  case $name in EXOSCALE_*) unset "$name" ;; esac
done

export EXOSCALE_API_KEY="op://$vault/$item/username"
export EXOSCALE_API_SECRET="op://$vault/$item/credential"

exec op run --account "$account" -- "$@"
